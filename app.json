{
  "expo": {
    "name": "Family Portal",
    "slug": "roost-family-portal",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "roost",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roost.familyportal"
    },
    "android": {
      "package": "com.roost.familyportal",
      "adaptiveIcon": {
        "backgroundColor": "#FBF4E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/family-portal"
    },
    "extra": {
      "googleOAuthClientIdAndroid": "1087417379912-n9uju75j3t1qo6rb4u52n3ffthgd21ua.apps.googleusercontent.com",
      "googleOAuthClientIdIos": "1087417379912-5hp7a1j8a4jdarp2eeo9kjlfd7qokn1u.apps.googleusercontent.com",
      "googleOAuthClientIdWeb": "1087417379912-r916hk7onvur1gs70feavqb6d8spmknd.apps.googleusercontent.com",
      "eas": {
        "projectId": "9c800daa-9070-4e87-8184-13dae38fbbcd"
      }
    },
    "owner": "famos-amos"
  }
}
